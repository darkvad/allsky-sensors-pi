# À copier en /etc/allsky-sensors/allsky-sensors.env (chmod 600). Le mot de passe MQTT ne doit figurer nulle part ailleurs.
# Le dossier /etc/allsky-sensors doit appartenir au compte du service (mode 750) : l'interface web y écrit.
MQTT_HOST=adresse-du-serveur-linux
MQTT_PORT=1883
MQTT_USER=allsky-pi
MQTT_PASSWORD=change-me
MQTT_PREFIX=allsky

# Capteurs à lire : bme280 (extérieur, I2C), ds18b20 (dôme, 1-Wire) et/ou mlx90614 (ciel, I2C)
ENABLED=bme280,ds18b20
BME280_ADDRESS=0x76
# Altitude du capteur BME280, en mètres. Si elle est renseignée, outdoor_pressure est la pression ramenée au niveau de la mer
# (usage météo) et la pression mesurée est publiée à part (outdoor_pressure_station). Sinon, pression mesurée seule.
# ALTITUDE_M=500
# Si plusieurs DS18B20 sont branchés, indiquer l'identifiant de celui du dôme (ex. 28-0123456789ab)
DS18B20_ID=
# Correction (°C) ajoutée à la mesure du DS18B20, si la sonde lit faux (ex. clone : 3 pour une sonde qui lit 3 °C trop bas).
# À caler sur un thermomètre de référence ; vérifier aussi à basse température (frigo, 4-5 °C).
DS18B20_OFFSET_C=3.0
# --- MLX90614 (température du ciel) : ajoute mlx90614 à ENABLED pour le lire ----------------------
# Adresse I2C : 0x5A sur tous les modules neufs (la changer demande de reprogrammer l'EEPROM).
MLX90614_ADDRESS=0x5A
# Correction (°C) ajoutée à la mesure du ciel, si le capteur ou sa fenêtre d'entrée décale la lecture.
# Repère : visé sur un mur à l'ombre, il doit annoncer la température de l'air (BME280) à 1-2 °C près.
MLX90614_OFFSET_C=0
# Secondes entre deux publications
INTERVAL=60

# --- Chauffage anti-buée (désactivé par défaut) -------------------------------------------------
HEATER_ENABLED=0
# OBLIGATOIRE si le chauffage est activé : tension qui alimente les résistances (pas celle de la Pi).
# Le programme en déduit le rapport cyclique maximal : chaque résistance ne dépasse jamais la moitié de sa puissance nominale.
HEATER_SUPPLY_VOLTS=5
# GPIO23 (broche 16) : voisin de la masse (broche 14). 17, 18, 22 et 27 sont pris par le focuser.
HEATER_GPIO=23
# GPIO déjà utilisés par d'autres matériels : le programme refuse de s'en servir pour le chauffage
GPIO_RESERVED=17,18,22,27
HEATER_PWM_HZ=100
HEATER_RESISTORS=6
HEATER_RESISTOR_OHMS=47
HEATER_RESISTOR_RATING_WATTS=1
# Température visée = point de rosée + marge (°C)
HEATER_MARGIN=4
# Le chauffage est coupé si le dôme atteint cette température (°C)
HEATER_MAX_DOME_TEMP=35
# Réglages du régulateur PI (points de départ validés en simulation ; à ajuster sur ton dôme)
HEATER_KP=0.3
HEATER_KI=0.0002

# --- Interface web (allsky-sensors-web) --------------------------------------------------------
# Écoute du serveur : 0.0.0.0 = tout le réseau local, 127.0.0.1 = cette machine seulement.
# N'expose jamais ce port sur Internet : Basic auth circule en clair (tunnel SSH pour l'extérieur).
WEB_BIND=0.0.0.0
WEB_PORT=8080
WEB_USER=admin
# OBLIGATOIRE (12 caractères au moins) : tant qu'elle est vide, le service web refuse de démarrer.
# Le fichier doit appartenir au compte qui lance le service, pour que l'interface puisse le modifier.
WEB_PASSWORD=

