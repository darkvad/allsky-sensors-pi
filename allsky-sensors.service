[Unit]
Description=Capteurs et chauffage anti-buée de l'allsky (MQTT)
After=network-online.target
Wants=network-online.target

[Service]
# Le compte est substitué à l'installation (voir README) ; à défaut, mets ton compte ici.
User=TON_UTILISATEUR
EnvironmentFile=/etc/allsky-sensors/allsky-sensors.env
# Le service relit ce fichier dès qu'il change : les réglages modifiés (interface web, éditeur) sont
# appliqués sans redémarrage, au tick suivant (10 s avec chauffage, 30 s au plus sinon).
Environment=ENV_FILE=/etc/allsky-sensors/allsky-sensors.env
ExecStart=/opt/allsky-sensors/venv/bin/python /opt/allsky-sensors/allsky_sensors_mqtt.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
# Chien de garde : si le programme se fige, systemd le tue (ce qui coupe la PWM) puis le relance.
NotifyAccess=main
WatchdogSec=90

[Install]
WantedBy=multi-user.target
